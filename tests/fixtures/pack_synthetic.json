{
  "id": "synthetic",
  "title": "Synthetic fixture flow",
  "ecu_family": "synthmarelli",
  "symptoms": ["crank\\w*.*(won'?t|not).*(start|fire)"],
  "start": "DTCS",
  "terminals": {
    "CAPTURE_DTCS": "Capture DTCs first.",
    "BATT_LOW": "Battery low.",
    "SUPPLY_LOW": "Supply low.",
    "SUPPLY_HIGH": "Supply high.",
    "WIRE_DROP": "Wire drop too big.",
    "MYSTERY": "Mystery fault.",
    "GROUND_BAD": "Ground bad.",
    "COMMS_OK": "Comms ok.",
    "COMMS_FAULT": "Comms fault."
  },
  "gates": [
    {"id": "DTCS", "type": "boolean", "title": "DTCs captured", "captures_dtcs": true,
     "instruction": "Record all codes.", "safeguard": "Do not clear codes.",
     "next": {"YES": "BATT", "NO": "TERMINAL-CAPTURE_DTCS"}},
    {"id": "BATT", "type": "threshold", "title": "Battery floor", "quantity": "battery voltage", "condition": "CRANKING",
     "unit": "V", "op": ">=", "spec_ref": "synthmarelli.battery_floor_cranking",
     "instruction": "Meter the battery posts while cranking.", "safeguard": "Measure at the posts.",
     "next": {"PASS": "ECUPWR", "FAIL": "TERMINAL-BATT_LOW"}},
    {"id": "ECUPWR", "type": "window", "title": "ECU supply", "quantity": "ECU supply", "condition": "KOEO",
     "unit": "V", "spec_ref": "synthmarelli.ecu_supply_koeo",
     "instruction": "Meter the ECU supply pin, key on engine off.", "safeguard": "Engine stays off.",
     "next": {"LOW": "TERMINAL-SUPPLY_LOW", "PASS": "WIRE", "HIGH": "TERMINAL-SUPPLY_HIGH"}},
    {"id": "WIRE", "type": "threshold", "title": "Wire drop", "quantity": "voltage drop", "condition": "RUNNING",
     "unit": "V", "op": "<=", "spec_ref": "synthmarelli.wire_drop_running",
     "literal": {"value": 4.44, "unit": "V", "cite": "synthetic.md p.1"},
     "instruction": "Meter the drop across the supply wire, engine running.", "safeguard": "Keep clear of belts.",
     "next": {"PASS": "MYSTERY", "FAIL": "TERMINAL-WIRE_DROP"}},
    {"id": "MYSTERY", "type": "threshold", "title": "Mystery drop", "quantity": "mystery drop", "condition": "KOEO",
     "unit": "V", "op": "<=", "spec_ref": "synthmarelli.mystery_drop_koeo",
     "instruction": "Meter the mystery drop, key on engine off.", "safeguard": "Engine stays off.",
     "next": {"PASS": "GND", "FAIL": "TERMINAL-MYSTERY"}},
    {"id": "GND", "type": "boolean", "title": "Ground bad", "condition": "KEY_OFF", "cuts_power": true,
     "instruction": "Disconnect the battery and inspect the ground. Is it damaged?", "safeguard": "DTCs captured first.",
     "next": {"YES": "TERMINAL-GROUND_BAD", "NO": "PROBE"}},
    {"id": "PROBE", "type": "boolean", "title": "Traffic present", "condition": "KOEO",
     "risk": "Back-probing a sealed connector breaks the seal.",
     "instruction": "Back-probe the bus line. Is there traffic?", "safeguard": "Reseal the connector.",
     "next": {"YES": "TERMINAL-COMMS_OK", "NO": "TERMINAL-COMMS_FAULT"}}
  ]
}
